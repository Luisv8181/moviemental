{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moviemental Recommendation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "goal",
    "work_ids",
    "why_it_may_fit",
    "limitations",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "goal": {
      "enum": [
        "feel_understood",
        "understand_an_experience",
        "explore_coping",
        "reflect_on_identity_or_relationships",
        "find_hope_or_companionship",
        "study_representation",
        "facilitate_discussion",
        "other"
      ]
    },
    "goal_detail": {
      "type": "string"
    },
    "work_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "journey_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_it_may_fit": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "emotional_intensity": {
      "enum": [
        "gentle",
        "moderate",
        "intense",
        "variable",
        "unknown"
      ]
    },
    "content_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "draft",
        "needs_sources",
        "in_review",
        "reviewed",
        "contested",
        "archived"
      ]
    }
  }
}
