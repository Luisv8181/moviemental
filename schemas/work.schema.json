{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moviemental Work Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "media_type",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "enum": [
        "film",
        "television_series",
        "television_episode",
        "animation",
        "anime",
        "video_game",
        "book",
        "graphic_novel",
        "podcast",
        "other"
      ]
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2200
    },
    "country_or_region": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creator_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "draft",
        "needs_sources",
        "in_review",
        "reviewed",
        "contested",
        "archived"
      ]
    }
  }
}
