{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moviemental Journey Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "journey_type",
    "stages",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "journey_type": {
      "type": "string",
      "minLength": 1
    },
    "character_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "label"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "turning_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "support_and_barriers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome_type": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "draft",
        "needs_sources",
        "in_review",
        "reviewed",
        "contested",
        "archived"
      ]
    }
  }
}
